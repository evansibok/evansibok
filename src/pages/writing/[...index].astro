---
// The writing index only exists once at least one essay is published.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { publishedEssays, essayUrl, month } from "../../lib/writing";

export async function getStaticPaths() {
  const essays = await publishedEssays();
  return essays.length > 0 ? [{ params: { index: undefined } }] : [];
}

const essays = await publishedEssays();
const byYear = Map.groupBy(essays, (e) => e.data.date.getUTCFullYear());
const nav = [
  { label: "Writing", href: "/writing/" },
  { label: "evns.fyi", href: "/" },
];
---

<Base title="Writing" description="Essays by Evans Ibok on building software that stays inside its limits.">
  <div class="wrap">
    <Header links={nav} />
    <section class="index-head">
      <h1>Writing</h1>
      <p>Essays on building software that stays inside its limits: permissions, safety, and the people on the other side of the system.</p>
    </section>
    <section class="index-body">
      {
        [...byYear].map(([year, list]) => (
          <>
            <h2 class="year">{year}</h2>
            <ul class="posts">
              {list.map((e) => (
                <li>
                  <a href={essayUrl(e)}>{e.data.title}</a>
                  <time datetime={e.data.date.toISOString().slice(0, 7)}>{month(e.data.date)}</time>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </section>
    <Footer />
  </div>
</Base>
