---
// The opening block: optional role pill, big name with a squiggle, the lead sentence, and link buttons.
import Sticker from "./Sticker.astro";
import PillLink from "./PillLink.astro";
import type { Link } from "../data/profile";

interface Props {
  title: string;
  eyebrow?: string;
  links?: Link[];
}

const { title, eyebrow, links = [] } = Astro.props;
---

<section class="hero">
  {eyebrow && <Sticker as="p" variant="pill" tint="mint" tilt={-1.5}>{eyebrow}</Sticker>}
  <h1>
    {title}<svg class="squiggle" viewBox="0 0 168 14" aria-hidden="true"
      ><path
        d="M2 9 C 14 2, 24 2, 34 8 S 56 14, 68 7 S 90 1, 102 8 S 124 14, 136 7 S 156 2, 166 7"
        fill="none"
        stroke="currentColor"
        stroke-width="3.5"
        stroke-linecap="round"></path></svg
    >
  </h1>
  <p class="lead"><slot /></p>
  {
    links.length > 0 && (
      <ul class="links">
        {links.map((l) => (
          <li>
            <PillLink href={l.href}>{l.label}</PillLink>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .hero { padding-block: 64px 48px; display: grid; gap: 22px; }
  @container site (min-width: 1000px) {
    .hero { padding-block: 112px 72px; }
  }
  h1 {
    margin: 0;
    font: 800 clamp(2.6rem, 11cqi, 4rem) / 1 var(--display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .squiggle { display: block; width: 168px; height: 14px; margin-top: -6px; color: var(--coral); }
  .lead { margin: 0; font-size: var(--step-1); line-height: 1.55; max-width: 34em; text-wrap: pretty; }
  .lead :global(em) {
    font-style: normal;
    font-weight: 600;
    background: linear-gradient(transparent 55%, var(--accent-soft) 55%);
    padding: 0 2px;
  }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin: 4px 0 0; padding: 0; list-style: none; font-size: var(--step--1); }
</style>
