---
// One thing Evans has built: its name, whether it's still being built, what it does, and where to find it.
import Snippet from "./Snippet.astro";
import type { BuiltItem } from "../data/profile";

interface Props {
  item: BuiltItem;
}

const { item } = Astro.props;
---

<div class="item">
  <div class="head">
    <span class="name">{item.name}</span>
    <span class:list={["status", item.status]}>{item.status === "building" ? "Building" : "Shipped"}</span>
  </div>
  <p>{item.body}</p>
  {item.snippet && <Snippet code={item.snippet.code} label={item.snippet.label} />}
  <div class="links">
    {item.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
  </div>
</div>

<style>
  .item { display: grid; gap: 14px; }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .name { font: 700 var(--step-1) var(--display); }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 var(--step--1) var(--mono);
    color: var(--muted);
  }
  .status::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--surface), 0 0 0 5px var(--ink);
  }
  .building::before { background: var(--coral); animation: pulse 1.8s ease-in-out infinite; }
  .shipped::before { background: var(--mint); }
  @keyframes pulse {
    50% { transform: scale(1.25); }
  }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: var(--step--1); color: var(--muted); }
</style>
