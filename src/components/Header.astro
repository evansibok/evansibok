---
import Logo from "./Logo.astro";
import { profile } from "../data/profile";
import type { Link } from "../data/profile";

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<header class="top">
  <a class="mark" href="/"><Logo />{profile.name}</a>
  <nav aria-label="Site">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 28px 0;
    font-size: var(--step--1);
  }
  a { text-decoration: none; }
  .mark { display: inline-flex; align-items: center; gap: 5px; font: 800 1.05rem var(--display); letter-spacing: -0.01em; white-space: nowrap; }
  nav { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); }
  /* Narrow screens: name on its own row, links in one row beneath it. */
  @container site (max-width: 560px) {
    .top { flex-direction: column; align-items: flex-start; gap: 14px; }
    nav { gap: 6px 16px; }
  }
  nav a:hover { color: var(--accent); }
</style>
