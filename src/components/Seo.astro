---
// Everything in <head> that describes the page to search engines, social sites and AI tools.
import { profile } from "../data/profile";

export interface SeoProps {
  title?: string;
  description?: string;
  // Path to the 1200×630 sharing image.
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  // A plain-Markdown copy of this page, for AI tools.
  markdown?: string;
  jsonLd?: object[];
}

const {
  title,
  description = profile.description,
  image = "/og/home.png",
  imageAlt = `${profile.name}: ${profile.thesis.before}${profile.thesis.highlight}.`,
  type = "website",
  publishedAt,
  markdown,
  jsonLd = [],
} = Astro.props as SeoProps;

const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#f1f4ff" />

<link rel="alternate" type="application/rss+xml" title={`${profile.name}: Writing`} href="/rss.xml" />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

<meta property="og:site_name" content="evns.fyi" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? profile.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{type === "article" && <meta property="article:author" content={profile.name} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@iamevns" />
<meta name="twitter:creator" content="@iamevns" />
<meta name="twitter:title" content={title ?? profile.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
