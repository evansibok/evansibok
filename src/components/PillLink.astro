---
// A chunky outlined link button. External links open in a new tab and get an arrow.
interface Props {
  href: string;
  // "sun" marks the main action.
  tone?: "plain" | "sun";
}

const { href, tone = "plain" } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a class:list={["pill", tone, { external }]} href={href} {...external && { target: "_blank", rel: "noopener" }}><slot /></a>

<style>
  .pill {
    display: inline-block;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 5px 12px;
    box-shadow: 3px 3px 0 var(--shadow);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .sun { background: var(--sun); color: var(--sticker-ink); }
  .sun:hover { color: var(--sticker-ink); }
  .external::after { content: " ↗"; color: var(--faint); }
  .pill:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--shadow); color: var(--fg); }
  .pill:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--shadow); }
</style>
