---
// A list of essays with their dates, used on the home page and the writing index.
import { essayUrl, month, monthYear, type Essay } from "../lib/writing";

interface Props {
  essays: Essay[];
  // "month" when a year heading already sits above the list.
  date?: "month" | "monthYear";
}

const { essays, date = "monthYear" } = Astro.props;
const format = date === "month" ? month : monthYear;
---

<ul class="posts">
  {
    essays.map((e) => (
      <li>
        <a href={essayUrl(e)}>{e.data.title}</a>
        <time datetime={e.data.date.toISOString().slice(0, 7)}>{format(e.data.date)}</time>
      </li>
    ))
  }
</ul>

<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; }
  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent);
  }
  li:first-child { padding-top: 0; }
  li:last-child { border-bottom: 0; }
  a { text-decoration: none; font-weight: 500; min-width: 0; }
  a:hover { color: var(--accent); }
  time { flex: none; font: var(--step--1) var(--mono); color: var(--faint); font-variant-numeric: tabular-nums; }
</style>
