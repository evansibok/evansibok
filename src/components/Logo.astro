---
// The site mark, inlined so it costs no extra request. Decorative: the name always sits next to it.
import { iconSvg } from "../lib/icon";

interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<span class="logo" style={`--size: ${size}px`} aria-hidden="true" set:html={iconSvg} />

<style>
  .logo { display: inline-flex; width: var(--size); height: var(--size); flex: none; }
  .logo :global(svg) { width: 100%; height: 100%; }
</style>
