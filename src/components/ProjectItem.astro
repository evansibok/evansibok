---
// One side project: its name (with a pulsing dot while in progress), what it does, and where to find it.
import Snippet from "./Snippet.astro";
import type { Project } from "../data/profile";

interface Props {
  item: Project;
}

const { item } = Astro.props;
---

<div class="item">
  <div class="head">
    <span class="name">{item.name}</span>
    {item.status === "building" && <span class="live" role="img" aria-label="In progress" title="In progress"></span>}
  </div>
  <p>{item.body}</p>
  {item.snippet && <Snippet code={item.snippet.code} label={item.snippet.label} />}
  <div class="links">
    {item.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
  </div>
</div>

<style>
  .item { display: grid; gap: 14px; }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .name { font: 700 var(--step-1) var(--display); }
  /* Shown only while a project is in progress. */
  .live {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 3px var(--surface), 0 0 0 5px var(--ink);
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    50% { transform: scale(1.25); }
  }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: var(--step--1); color: var(--muted); }
</style>
