---
// One thing Evans is working on now, with a pulsing marker, an optional config snippet and links.
import Snippet from "./Snippet.astro";
import type { NowItem } from "../data/profile";

interface Props {
  item: NowItem;
}

const { item } = Astro.props;
---

<div class="now-item">
  <span class="tag">{item.title}</span>
  <p>{item.body}</p>
  {item.snippet && <Snippet code={item.snippet} label="Example nanny.toml" />}
  <div class="links">
    {item.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
  </div>
</div>

<style>
  .now-item { display: grid; gap: 14px; }
  .tag { display: inline-flex; align-items: center; gap: 8px; font: 700 var(--step-1) var(--display); }
  .tag::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 3px var(--surface), 0 0 0 5px var(--ink);
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    50% { transform: scale(1.25); }
  }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: var(--step--1); color: var(--muted); }
</style>
