---
// A heading that breaks lines between phrases, not inside them. The text is split after each comma;
// each phrase is an inline block, so it moves to the next line whole when it doesn't fit, and only
// wraps inside itself when it's wider than the screen.
interface Props {
  text: string;
  as?: "h1" | "h2";
}

const { text, as: Tag = "h1" } = Astro.props;
const phrases = text.split(/(?<=,)\s+/);
---

<Tag class="phrase-title">
  {phrases.map((p, i) => <><span class="phrase">{p}</span>{i < phrases.length - 1 && " "}</>)}
</Tag>

<style>
  .phrase { display: inline-block; text-wrap: pretty; }
</style>
