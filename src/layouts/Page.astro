---
// Every page's shell: the document head, a centred column, the header and the footer.
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { SeoProps } from "../components/Seo.astro";
import type { Link } from "../data/profile";

interface Props extends SeoProps {
  nav: Link[];
  // The wider reading column used by essays.
  read?: boolean;
}

const { nav, read = false, ...seo } = Astro.props;
---

<Base {...seo}>
  <div class:list={["wrap", { read }]}>
    <Header links={nav} />
    <slot />
    <Footer />
  </div>
</Base>
